# Server
PORT=3000
# Public origin used as the Google redirect base. No trailing slash.
APP_ORIGIN=http://localhost:3000
# Signs the session cookie. Use a long random string in production.
AUTH_SECRET=replace-with-a-long-random-string

# Where accounts, briefs, and uploads are stored.
# On Railway, point this at a volume. On Vercel the disk is ephemeral;
# the app falls back to /tmp/cozy-data when VERCEL=1 and DATA_DIR is unset.
DATA_DIR=./data

# Comma-separated emails that should be admins when they sign in.
# Match the mailbox you use on the Cozy Client Hub if you want the same person
# to be an admin in both products later. This app does not read the hub database.
ADMIN_EMAILS=you@cozydigital.org

# Google sign-in. Same shape as the hub: the button hits GET /api/auth/google.
# Create a Web client in Google Cloud, and add this redirect:
#   http://localhost:3000/api/auth/google/callback
#   https://YOUR_DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dev-only sign-in buttons. Off in production unless you set this to 1.
ALLOW_DEV_LOGIN=

# Higgsfield. The documented header is "Authorization: Key ID:SECRET".
# Set either the pair, or HIGGSFIELD_API_KEY as "id:secret".
# If neither is set, the admin UI runs in an obvious mock mode and does not
# call Higgsfield.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
# Optional aliases accepted by the adapter:
# HF_API_KEY_ID=
# HF_API_KEY_SECRET=

# Stripe is a seam only. Leaving this empty keeps checkout disabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_COZY_AGENT=

# Where "Book a call" sends people. Defaults to the studio booking page.
BOOKING_URL=https://www.cozydigital.org/cozy-booking/
